# --- Database (docker-compose sets this automatically for the backend container) ---
DATABASE_URL=postgresql://whythis:whythis@localhost:5432/whythis

# --- Hugging Face Inference API ---
# Reuse the token already set up for Startupvalidatior/Travel_Agent.
HUGGINGFACEHUB_API_TOKEN=
# HF_TOKEN=                      # alternative env var name, used as a fallback
HF_PROVIDER=auto
EMBEDDING_MODEL=sentence-transformers/all-MiniLM-L6-v2
CHAT_MODEL=Qwen/Qwen2.5-72B-Instruct

# GitHub/Slack/Jira credentials are no longer set here — WhyThis is multi-tenant now.
# Each client creates a project from the dashboard's Settings page (POST /projects),
# gets an API key, and connects their own GitHub/Slack/Jira from there
# (PATCH /projects/me/integrations). See README.md.
